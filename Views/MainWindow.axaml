<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeoDraw.ViewModels"
        xmlns:controls="using:GeoDraw.Controls"
        x:Class="GeoDraw.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="GeoDraw"
        Width="1280" Height="820"
        Background="#FFFFFF">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <DockPanel>

    <!-- 顶部工具栏 -->
    <Border DockPanel.Dock="Top" Padding="6" Background="#f4f4f4"
            BorderBrush="#ccc" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center">

          <Button x:Name="NewButton" Content="New ▾">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Point"   Tag="Point"   Click="OnToolMenuClicked"/>
                <MenuItem Header="Line"    Tag="Line"    Click="OnToolMenuClicked"/>
                <MenuItem Header="Rect"    Tag="Rect"    Click="OnToolMenuClicked"/>
                <MenuItem Header="Circle"  Tag="Circle"  Click="OnToolMenuClicked"/>
                <MenuItem Header="Ellipse" Tag="Ellipse" Click="OnToolMenuClicked"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button Content="Select"
                  Command="{Binding SetToolCommand}" CommandParameter="Select"/>

          <Button x:Name="ViewButton" Content="View ▾">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Off"       Tag="None"     Click="OnViewMenuClicked"/>
                <MenuItem Header="Point IDs" Tag="PointIds" Click="OnViewMenuClicked"/>
                <MenuItem Header="Line IDs"  Tag="PathIds"  Click="OnViewMenuClicked"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button x:Name="OperateButton" Content="Operate ▾">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Connect (one curve)" Tag="ConnectOneCurve" Click="OnOperateMenuClicked"/>
                <MenuItem Header="Connect (M)" Tag="ConnectM" Click="OnOperateMenuClicked"/>
                <MenuItem Header="Connect (Q)" Tag="ConnectQ" Click="OnOperateMenuClicked"/>
                <MenuItem Header="Connect (C)" Tag="ConnectC" Click="OnOperateMenuClicked"/>
                <Separator/>
                <MenuItem Header="Rotate…" Tag="Rotate" Click="OnOperateMenuClicked"/>
                <MenuItem Header="Reflect across point" Tag="ReflectPoint" Click="OnOperateMenuClicked"/>
                <MenuItem Header="Reflect across line" Tag="ReflectLine" Click="OnOperateMenuClicked"/>
                <MenuItem Header="Duplicate" Tag="Duplicate" Click="OnOperateMenuClicked"/>
                <Separator/>
                <MenuItem Header="Next object (Ctrl+→)" Tag="SelectNext" Click="OnOperateMenuClicked"/>
                <MenuItem Header="Prev object (Ctrl+←)" Tag="SelectPrev" Click="OnOperateMenuClicked"/>
                <Separator/>
                <MenuItem Header="Delete selected" Tag="Delete" Click="OnOperateMenuClicked"/>
                <MenuItem Header="Clear all" Tag="Clear" Click="OnOperateMenuClicked"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button x:Name="FileButton" Content="File ▾">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Import JSON" Tag="ImportJson" Click="OnFileMenuClicked"/>
                <MenuItem Header="Export JSON" Tag="ExportJson" Click="OnFileMenuClicked"/>
                <MenuItem Header="Export SVG"  Tag="ExportSvg"  Click="OnFileMenuClicked"/>
                <MenuItem Header="Export PNG"  Tag="ExportPng"  Click="OnFileMenuClicked"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button Content="Style" Click="OnStyleClicked"/>
        </StackPanel>

        <TextBox Grid.Column="1" Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Text="{Binding CliInput}"
                 PlaceholderText="select p1 | which p1 | help"
                 KeyDown="OnCliKeyDown"/>
      </Grid>
    </Border>

    <!-- 右侧信息面板 -->
    <Border DockPanel.Dock="Right" Width="320" Padding="10"
            Background="#fafafa" BorderBrush="#ccc" BorderThickness="1,0,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Info"
                   FontWeight="Bold" FontSize="16"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <ScrollViewer>
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ToolLabel}" FontSize="14"/>
            <TextBlock Text="{Binding ViewLabel}" FontSize="14"/>

            <Separator Margin="0,6"/>

            <TextBlock Text="Selection" FontWeight="Bold" FontSize="14"/>
            <TextBlock Text="{Binding SelectedSummary}"
                       FontSize="14" TextWrapping="Wrap"/>

            <StackPanel Spacing="4" IsVisible="{Binding HasSingleSelection}">
              <TextBlock Text="{Binding SelId}" FontWeight="Bold" FontSize="14"/>

              <StackPanel Spacing="4" IsVisible="{Binding IsPointSelected}">
                <Grid ColumnDefinitions="40,*">
                  <TextBlock Text="X" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" Text="{Binding SelX, Mode=TwoWay}"/>
                </Grid>
                <Grid ColumnDefinitions="40,*">
                  <TextBlock Text="Y" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" Text="{Binding SelY, Mode=TwoWay}"/>
                </Grid>
                <TextBlock Text="Radius"/>
                <Slider Minimum="1" Maximum="30"
                        Value="{Binding SelRadius, Mode=TwoWay}"/>
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding IsPathSelected}">
                <TextBlock Text="{Binding SelSegmentCount, StringFormat='Segments: {0}'}"/>
                <TextBlock Text="Width"/>
                <Slider Minimum="1" Maximum="20"
                        Value="{Binding SelWidth, Mode=TwoWay}"/>
              </StackPanel>
            </StackPanel>

            <Separator Margin="0,6"/>

            <TextBlock Text="Log" FontWeight="Bold" FontSize="14"/>
			<ScrollViewer x:Name="LogScrollViewer" Height="150" VerticalScrollBarVisibility="Auto">
			  <TextBlock Text="{Binding LogText}"
                           FontSize="14" TextWrapping="Wrap" Foreground="#444"/>
			</ScrollViewer>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <controls:DrawingCanvas x:Name="DrawCanvas"
                            Document="{Binding Document}"
                            SelectedObjects="{Binding SelectedObjects}"
                            Tool="{Binding Tool}"
                            CurrentStyle="{Binding CurrentStyle}"
                            ViewMode="{Binding ViewMode}"/>
  </DockPanel>
</Window>