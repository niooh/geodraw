<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeoDraw.ViewModels"
        x:Class="GeoDraw.Views.RotateWindow"
        x:DataType="vm:MainViewModel"
        Title="Rotate" Width="360" Height="220"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="16" Spacing="10">
    <Grid ColumnDefinitions="80,*">
      <TextBlock Text="Direction" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
        <RadioButton GroupName="dir" Content="CW"
                     IsChecked="{Binding RotateClockwise, Mode=TwoWay}"/>
        <RadioButton GroupName="dir" Content="CCW"
                     IsChecked="{Binding RotateCounterClockwise, Mode=TwoWay}"/>
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="80,*">
      <TextBlock Text="Angle (°)" VerticalAlignment="Center"/>
      <TextBox Grid.Column="1" Text="{Binding RotateAngle, Mode=TwoWay}"
               TextInput="OnAngleTextInput"/>
    </Grid>

    <Grid ColumnDefinitions="80,*">
      <TextBlock Text="Repeat" VerticalAlignment="Center"/>
      <TextBox x:Name="RepeatTextBox" Grid.Column="1"
               Text="{Binding RotateCount, Mode=TwoWay}"
               TextInput="OnRepeatTextInput"
               LostFocus="OnRepeatLostFocus"/>
    </Grid>

    <Button Content="Apply Rotate" HorizontalAlignment="Right"
            Click="OnApplyClicked" Margin="0,10,0,0"/>
  </StackPanel>
</Window>