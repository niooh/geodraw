<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeoDraw.ViewModels"
        x:Class="GeoDraw.Views.RotateWindow"
        x:DataType="vm:MainViewModel"
        Title="Rotate" Width="340" Height="280"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="Direction" FontWeight="Bold"/>
    <StackPanel Orientation="Horizontal" Spacing="16">
      <RadioButton GroupName="dir" Content="CW"
                   IsChecked="{Binding RotateClockwise, Mode=TwoWay}"/>
      <RadioButton GroupName="dir" Content="CCW"
                   IsChecked="{Binding RotateCounterClockwise, Mode=TwoWay}"/>
    </StackPanel>

    <TextBlock Text="Angle (°)" FontWeight="Bold"/>
    <TextBox Text="{Binding RotateAngle, Mode=TwoWay}"/>

    <TextBlock Text="Repeat" FontWeight="Bold"/>
    <Slider Minimum="1" Maximum="16"
            Value="{Binding RotateCount, Mode=TwoWay}"
            TickFrequency="1" IsSnapToTickEnabled="True"/>

    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                Margin="0,10,0,0">
      <Button Content="Close" Click="OnCloseClicked"/>
      <Button Content="Apply Rotate" Click="OnApplyClicked"/>
    </StackPanel>
  </StackPanel>
</Window>
